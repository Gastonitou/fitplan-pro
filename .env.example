# Supabase Projekt-Daten
# 1. Gehe zu https://supabase.com/dashboard
# 2. Erstelle ein neues Projekt
# 3. Kopiere Project URL und anon/public key aus Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-hier

# Google Gemini API Key (kostenlos: https://aistudio.google.com/app/apikey)
# Benötigt für KI-Lebensmittelerkennung (Google Lens Funktion im Scanner)
EXPO_PUBLIC_GEMINI_API_KEY=dein-gemini-api-key-hier
